#!/usr/bin/env bash
set -euo pipefail

# ─────────────────────────────────────────────
# Install Git Hooks
# Symlinks hooks from hooks/ into .git/hooks/
# ─────────────────────────────────────────────

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
HOOKS_SOURCE="$PROJECT_ROOT/hooks"
HOOKS_TARGET="$PROJECT_ROOT/.git/hooks"

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
BOLD='\033[1m'
NC='\033[0m'

info()    { echo -e "${BLUE}[INFO]${NC} $*"; }
success() { echo -e "${GREEN}[OK]${NC} $*"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $*"; }

if [[ ! -d "$HOOKS_SOURCE" ]]; then
    echo "No hooks/ directory found. Nothing to install."
    exit 0
fi

if [[ ! -d "$HOOKS_TARGET" ]]; then
    mkdir -p "$HOOKS_TARGET"
fi

installed=0

for hook_file in "$HOOKS_SOURCE"/*; do
    [[ -f "$hook_file" ]] || continue

    hook_name="$(basename "$hook_file")"
    target="$HOOKS_TARGET/$hook_name"

    # Back up existing hook if it's not already our symlink
    if [[ -e "$target" && ! -L "$target" ]]; then
        backup="$target.backup.$(date +%Y%m%d%H%M%S)"
        warn "Backing up existing $hook_name → $backup"
        mv "$target" "$backup"
    elif [[ -L "$target" ]]; then
        # Remove existing symlink
        rm "$target"
    fi

    # Create symlink
    ln -s "$hook_file" "$target"
    chmod +x "$hook_file"
    success "Installed $hook_name"
    ((installed++))
done

if [[ "$installed" -eq 0 ]]; then
    info "No hooks to install."
else
    echo ""
    echo -e "${GREEN}${BOLD}Installed $installed hook(s).${NC}"
fi
